# ============================================================================
# OmegaClip — Environment Variables
# Kopiere diese Datei nach `.env.local` (Entwicklung) bzw. `.env.production`
# (Worker-Deploy und `npm run prod:check`, siehe docs/production-setup.md)
# und fülle die Werte aus.
# Alles mit NEXT_PUBLIC_ Präfix landet im Browser-Bundle — niemals Secrets!
# ============================================================================

# ---------------------------------------------------------------------------
# Supabase  ·  https://supabase.com/dashboard/project/_/settings/api
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Umgeht RLS vollständig. Nur in Route Handlers / Trigger.dev-Tasks verwenden.
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# Cloudflare R2  ·  Dashboard → R2 → Manage API Tokens
# Zero-Egress-Storage für Sources, Proxies, Renders.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="omegaclip"
# Endpoint wird aus der Account-ID abgeleitet, hier nur bei abweichendem Setup setzen:
# R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
# Öffentliche HTTPS-Video-Domain des Buckets. Pflicht für Instagram und TikTok;
# beide laden das Video selbst herunter. Bei TikTok die Domain/den URL-Präfix verifizieren.
R2_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------
# https://aistudio.google.com/apikey  — Modell: gemini-3.8-flash (Clip-Analyse)
GEMINI_API_KEY=""
# Optional: Ersatz, wenn Gemini nicht antwortet. Jeder OpenAI-kompatible Anbieter,
# z. B. Mistral (https://console.mistral.ai, Gratis-Tarif „Experiment“) oder OpenAI.
AI_FALLBACK_BASE_URL="https://api.mistral.ai/v1"
AI_FALLBACK_API_KEY=""
AI_FALLBACK_MODEL="mistral-medium-latest"
# https://console.deepgram.com  — Modell: nova-3 (Wort-Timestamps + Diarization)
DEEPGRAM_API_KEY=""

# ---------------------------------------------------------------------------
# Remotion Lambda  ·  https://www.remotion.dev/docs/lambda/setup
# Ab 4 Mitarbeitern zusätzlich eine Company License: https://remotion.pro/license
# ---------------------------------------------------------------------------
REMOTION_AWS_ACCESS_KEY_ID=""
REMOTION_AWS_SECRET_ACCESS_KEY=""
REMOTION_AWS_REGION="us-east-1"
# Ausgabe von `npx remotion lambda functions deploy`
REMOTION_FUNCTION_NAME=""
# Ausgabe von `npx remotion lambda sites create`
REMOTION_SERVE_URL=""
# S3-Bucket der Lambda-Funktion (Renders werden danach nach R2 kopiert)
REMOTION_S3_BUCKET=""

# ---------------------------------------------------------------------------
# Trigger.dev v4  ·  https://cloud.trigger.dev
# Orchestriert Ingest → Transkription → Analyse → Render → Publishing.
# ---------------------------------------------------------------------------
TRIGGER_SECRET_KEY=""
TRIGGER_PROJECT_ID=""

# ---------------------------------------------------------------------------
# Stripe  ·  https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
# `stripe listen --forward-to localhost:3000/api/stripe/webhook`
# Ereignisse: customer.subscription.created/updated/deleted,
# checkout.session.completed, checkout.session.async_payment_succeeded,
# invoice.payment_failed
STRIPE_WEBHOOK_SECRET=""
# Preis-IDs (price_…), alle mit „Steuer inklusive" angelegt — die Beträge in
# src/lib/stripe/plans.ts sind Endkundenpreise. Nur Monatsabos, kein Jahrestarif.
# Tarifwechsel laufen über das Kundenportal: dort „Abos aktualisieren" mit
# allen drei Tarifpreisen erlauben und anteilige Verrechnung einschalten.
STRIPE_PRICE_STARTER_MONTHLY=""    # 19 €
STRIPE_PRICE_CREATOR_MONTHLY=""    # 39 €
STRIPE_PRICE_BUSINESS_MONTHLY=""   # 99 €
STRIPE_PRICE_CREDITS_100=""        # 15 €, Einmalzahlung
STRIPE_PRICE_CREDITS_300=""        # 42 €, Einmalzahlung
STRIPE_PRICE_CREDITS_600=""        # 79 €, Einmalzahlung

# ---------------------------------------------------------------------------
# YouTube Data API  ·  https://console.cloud.google.com/apis/credentials
# Scope: youtube.upload (sensitive) + youtube.readonly
#
# ACHTUNG — zwei harte Limits:
#  1) Ohne bestandenes Compliance-Audit sind Uploads auf `private` gezwungen.
#  2) videos.insert hat ein EIGENES Kontingent von 100 Uploads/Tag PRO PROJEKT
#     — über alle Kunden hinweg. Quota-Extension beantragen, bevor skaliert wird.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Callback wird aus NEXT_PUBLIC_APP_URL + /api/oauth/youtube/callback gebildet.
# GOOGLE_REDIRECT_URI ist nur eine Registrierungshilfe; der Code liest sie nicht.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/youtube/callback"
YOUTUBE_AUDIT_PASSED="false"

# ---------------------------------------------------------------------------
# TikTok Content Posting API  ·  https://developers.tiktok.com
# Scopes im implementierten Workflow: user.info.basic + video.upload.
# Clips gehen in die TikTok-Inbox; der Nutzer veröffentlicht in TikTok.
# Unbeaufsichtigtes Direct Posting ist nicht implementiert.
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# Callback wird aus NEXT_PUBLIC_APP_URL + /api/oauth/tiktok/callback gebildet.
# TIKTOK_REDIRECT_URI ist nur eine Registrierungshilfe; der Code liest sie nicht.
TIKTOK_REDIRECT_URI="http://localhost:3000/api/oauth/tiktok/callback"

# ---------------------------------------------------------------------------
# Meta / Instagram Graph API  ·  https://developers.facebook.com/apps
# Permissions: instagram_content_publish, instagram_basic, pages_show_list
#
# Voraussetzungen: IG Professional Account + verknüpfte Facebook-Page + App Review
# (2–4 Wochen). Limit: 100 Posts / rollende 24h, abfragbar über
# GET /{ig-user-id}/content_publishing_limit. Tokens laufen nach 60 Tagen ab.
# ---------------------------------------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
# Callback wird aus NEXT_PUBLIC_APP_URL + /api/oauth/instagram/callback gebildet.
# META_REDIRECT_URI ist nur eine Registrierungshilfe; der Code liest sie nicht.
META_REDIRECT_URI="http://localhost:3000/api/oauth/instagram/callback"
META_GRAPH_VERSION="v21.0"
# Nur für Business-Apps mit „Facebook Login for Business": ID der Konfiguration
# (Nutzer-Zugriffsschlüssel; instagram_basic, instagram_content_publish,
# pages_show_list, pages_read_engagement). Ersetzt dann `scope` im Login.
META_LOGIN_CONFIG_ID=""
META_APP_REVIEW_PASSED="false"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: Adresse für „Lieber mit einem Menschen?“ in der Hilfe unten rechts.
# Leer = die Hilfe bietet nur den KI-Assistenten an.
# NEXT_PUBLIC_SUPPORT_EMAIL=""
# Lokale Link-Pipeline: Ablage für Downloads und Job-Zustand (Default: ./.omegaclip-data)
# OMEGACLIP_DATA_DIR=""
# Pfad zu yt-dlp, falls es nicht im PATH liegt
# YTDLP_PATH=""
# YouTube-Anmeldung für yt-dlp, wenn YouTube anonyme Abrufe als Bot sperrt
# („Sign in to confirm you're not a bot"). Browser, in dem du bei YouTube
# angemeldet bist (`chrome`, `chrome:Profile 1`, `firefox`, `safari`) — macOS
# fragt beim ersten Mal nach dem Schlüsselbund-Zugriff. Am besten ein
# Zweitkonto: YouTube kann Konten sperren, die viel herunterladen.
# YTDLP_COOKIES_FROM_BROWSER=""
# Alternativ Pfad zu einer exportierten cookies.txt (Netscape-Format)
# YTDLP_COOKIES=""
# Auf dem Trigger.dev-Worker gibt es weder Browser noch Datei — dort die
# cookies.txt Base64-kodiert: `base64 -i cookies.txt | tr -d '\n'`
# YTDLP_COOKIES_BASE64=""
# Proxy für YouTube (Metadaten UND Download). Residential/ISP mit Sticky
# Session, z. B. http://nutzer:passwort@host:port oder socks5://…
# YTDLP_PROXY=""
# Nur für `npm run prod:check`: persönliches Supabase-Token, um SMTP und
# Redirect-URLs zu lesen (supabase.com/dashboard/account/tokens)
# SUPABASE_ACCESS_TOKEN=""

# ---------------------------------------------------------------------------
# Monitoring  ·  https://sentry.io → Projekt (Next.js) → Client Keys (DSN)
# Ohne DSN ist Sentry aus und wird gar nicht geladen. Der DSN ist kein
# Geheimnis (er steht ohnehin im Browser-Bundle). Aufgezeichnet werden nur
# Fehler, ohne IP, Cookies oder Header.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""

# Pflicht für OAuth und Publishing: zufälliger 32-Byte-Key für AES-256-GCM.
# Einmal erzeugen: `openssl rand -hex 32`. App und Worker brauchen denselben Key.
# Einen bestehenden Key nicht ersetzen: gespeicherte OAuth-Tokens wären unlesbar.
TOKEN_ENCRYPTION_KEY=""
# Konten ohne Credit- und Export-Grenzen, z. B. zum Testen (durch Komma getrennt)
# ADMIN_EMAILS=""
